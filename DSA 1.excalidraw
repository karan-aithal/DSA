      "updated": 1771615607094,
      "link": null,
      "locked": false,
      "text": "for (int i -> n)\n   currentSum += arr [i] ; \n    \n    if ( i >= k - 1 )\n\n            //> shrink window -- subtract  \n        --> currentSum -= arr [i - k - 1 ] )\n        --> Max ( currentSum ; MaxVal );\n    else \n        contimue ;\n\n}\n\nreturn MaxVal ;        ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for (int i -> n)\n   currentSum += arr [i] ; \n    \n    if ( i >= k - 1 )\n\n            //> shrink window -- subtract  \n        --> currentSum -= arr [i - k - 1 ] )\n        --> Max ( currentSum ; MaxVal );\n    else \n        contimue ;\n\n}\n\nreturn MaxVal ;        ",
      "autoResize": true,
      "lineHeight": 1.25
