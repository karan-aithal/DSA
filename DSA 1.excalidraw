      "versionNonce": 1070065085,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771613204513,
      "link": null,
      "locked": false,
      "text": "minaorb =  min (count (0) , count(1) )\nif (minorb > k)\n    count (L - 'a') --;    \n    l++;\nelse\n    maxLen++;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "minaorb =  min (count (0) , count(1) )\nif (minorb > k)\n    count (L - 'a') --;    \n    l++;\nelse\n    maxLen++;",
      "autoResize": true,
      "lineHeight": 1.25
    },
