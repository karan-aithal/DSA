      "index": "b6J",
      "roundness": null,
      "seed": 1410332752,
      "version": 821,
      "versionNonce": 263116368,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772005880843,
      "link": null,
      "locked": false,
      "text": "unordered_set <char> cs;\n\nfor ( int r = 0 ; r <= s.length() ; r++ )\n\n    if(cs.find(s[r]) == cs.end() ) // if not found in set\n         cs.insert(s[r]);  // Add to set and increment length\n         MaxLen = max(currentlen, MaxLen);\n\n\n    if (cs.find(s[r]) != cs.end() ) // if present in hashset\n            cs.clear(); // Reset set window and decrement Maxlen\n            l = r; // reset left pointer\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "unordered_set <char> cs;\n\nfor ( int r = 0 ; r <= s.length() ; r++ )\n\n    if(cs.find(s[r]) == cs.end() ) // if not found in set\n         cs.insert(s[r]);  // Add to set and increment length\n         MaxLen = max(currentlen, MaxLen);\n\n\n    if (cs.find(s[r]) != cs.end() ) // if present in hashset\n            cs.clear(); // Reset set window and decrement Maxlen\n            l = r; // reset left pointer\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
