      "boundElements": [],
      "updated": 1772015769763,
      "link": null,
      "locked": false,
      "text": "sum = 0;\n\nfor (int i = 0 ; i < n : i++)\n    sum = sum + num;\n    target = sum - k \n\nif (maparr.find(sum - k) == mapparr.end())\n    //if sum is not present \n    maparr[sum] = i;\n\nelse if (maparr.find(sum - k) != maparr.end())\n    // if sum is present\n    // calculate Length \n        --maparr[target] + 1 = L\n        -- i (currentsumIndex) = R\n    R - L\n\n ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sum = 0;\n\nfor (int i = 0 ; i < n : i++)\n    sum = sum + num;\n    target = sum - k \n\nif (maparr.find(sum - k) == mapparr.end())\n    //if sum is not present \n    maparr[sum] = i;\n\nelse if (maparr.find(sum - k) != maparr.end())\n    // if sum is present\n    // calculate Length \n        --maparr[target] + 1 = L\n        -- i (currentsumIndex) = R\n    R - L\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
