    {
      "id": "o5tHgOqTQn78HgiShidZC",
      "type": "text",
      "x": 2372.198770255183,
      "y": 851.1140443606749,
      "width": 618.3995361328125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
