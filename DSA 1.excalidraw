      "isDeleted": false,
      "boundElements": [],
      "updated": 1771613171280,
      "link": null,
      "locked": false,
      "text": "for (int r -> n)\n    int x = str[r];\n    count ( x - 'a')++;\nif count of (a || b ) > k \n    --> shrink window L++ \n    --> reduce count(l -'a')--;\n    if ( count (0) < count (1) )\n            a < b\n        if (count(0) > k)\n            ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for (int r -> n)\n    int x = str[r];\n    count ( x - 'a')++;\nif count of (a || b ) > k \n    --> shrink window L++ \n    --> reduce count(l -'a')--;\n    if ( count (0) < count (1) )\n            a < b\n        if (count(0) > k)\n            ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6bMT0h9laxPzX-M3UMlbh",
      "type": "text",
      "x": 990,
      "y": 664,
      "width": 359.95965576171875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
