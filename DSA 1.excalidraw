      "isDeleted": false,
      "boundElements": [],
      "updated": 1771613171280,
      "link": null,
      "locked": false,
      "text": "minaorb =  min (count (0) , count(1) )\nif (minorb > k)\n    count (L - 'a') --;    \n    l++;\nelse\n    maxLen++;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "minaorb =  min (count (0) , count(1) )\nif (minorb > k)\n    count (L - 'a') --;    \n    l++;\nelse\n    maxLen++;",
      "autoResize": true,
      "lineHeight": 1.25
