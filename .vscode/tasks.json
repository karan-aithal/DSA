{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },

      "windows": {
        "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
        "args": [
          "-g",
          "-std=c++17",
          "-Wall",
          "${file}",
          "-o",
          "${fileDirname}\\${fileBasenameNoExtension}.exe"
        ]
      },

      "linux": {
        "command": "/usr/bin/g++",
        "args": [
          "-g",
          "-std=c++17",
          "-Wall",
          "${file}",
          "-o",
          "${fileDirname}/${fileBasenameNoExtension}"
        ]
      }
    },

    {
      "label": "Clean Executable",
      "type": "shell",
      "problemMatcher": [],
      "windows": {
        "command": "cmd",
        "args": [
          "/c",
          "del",
          "/f",
          "/q",
          "${fileDirname}\\${fileBasenameNoExtension}.exe"
        ]
      },
      "linux": {
        "command": "rm",
        "args": [
          "-f",
          "${fileDirname}/${fileBasenameNoExtension}"
        ]
      }
    }
  ]
}