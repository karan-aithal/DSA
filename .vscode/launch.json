{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug C++ (Windows/Linux)",
      "type": "cppdbg",
      "request": "launch",
      // Required root-level program (Linux default style)
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "Build C++",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "windows": {
        "program": "C:\\Windows\\System32\\cmd.exe",
        "args": [
          "/c",
          "${fileDirname}\\${fileBasenameNoExtension}.exe < ${workspaceFolder}\\input.txt > ${workspaceFolder}\\output.txt"
        ],
        "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe"
      },
      "linux": {
        "program": "/bin/bash",
        "args": [
          "-c",
          "\"${fileDirname}/${fileBasenameNoExtension}\" < \"${workspaceFolder}/input.txt\" > \"${workspaceFolder}/output.txt\""
        ],
        "miDebuggerPath": "/usr/bin/gdb"
      },
      "postDebugTask": "Clean Executable"
    }
  ]
}